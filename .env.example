# --- Banco de dados (Supabase) ---
# Botão "Connect" no projeto -> aba ORMs -> Prisma
DATABASE_URL="postgresql://postgres.[ref]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase (Storage + client) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU-PROJETO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon public key]"
SUPABASE_SERVICE_ROLE_KEY="[service_role key — NUNCA expor no client]"

# --- Autenticação ---
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="[gerar-um-segredo-aleatorio]"
NEXTAUTH_URL="http://localhost:3000"

# --- Mercado Pago (cobrança da assinatura, PIX) ---
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN="[access token da conta do usuário]"
MERCADOPAGO_WEBHOOK_SECRET="[secret pra validar assinatura do webhook]"
